# Plausible Analytics (privacy-conscious, cookie-free).
# 1. Create a site at https://plausible.io
# 2. Use the Domain value from Site settings (no https://).
#    For GitHub Pages this is usually: anmolkumar2003.github.io
#    For Vercel this is usually: anmolios.vercel.app
# 3. Copy this file to .env and fill in the domain, then rebuild.

VITE_PLAUSIBLE_DOMAIN=

# Optional. Defaults to the official Plausible script.
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Vite public base path.
# Leave unset for automatic selection:
#   - Vercel builds (VERCEL=1) → /
#   - Everything else → /Portfolio/ (GitHub Pages)
# Override explicitly when needed:
# VITE_BASE_PATH=/
# VITE_BASE_PATH=/Portfolio/

# ---------------------------------------------------------------------------
# Visitor telemetry (real-time session monitoring)
# ---------------------------------------------------------------------------

# Frontend (safe to expose — anon key + RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Must be "true" to start client session tracking (opt-in).
VITE_TELEMETRY_ENABLED=true
VITE_TELEMETRY_HEARTBEAT_MS=30000

# Vercel serverless only (NEVER put these in VITE_* / frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEMETRY_INACTIVE_MS=300000
TELEMETRY_RATE_LIMIT_PER_MIN=60
TELEMETRY_WATCHER_STALE_MS=120000
ALLOWED_ORIGINS=https://anmolios.vercel.app,http://localhost:5173

# Optional IP intelligence (server-side). Use "none" to rely on Vercel geo headers only.
IP_INTEL_PROVIDER=none
# IP_INTEL_PROVIDER=ipinfo
# IP_INTEL_PROVIDER=ipapi
IP_INTEL_API_KEY=
